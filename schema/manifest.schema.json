{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AULA LED animation manifest",
  "type": "object",
  "required": [
    "id", "name", "author", "version", "license",
    "layouts", "fps", "smooth", "preview", "frames"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "license": { "type": "string", "minLength": 1, "maxLength": 40 },
    "min_app": { "type": "string" },
    "description": { "type": "string", "maxLength": 300 },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "fps": { "type": "number", "minimum": 1, "maximum": 60 },
    "smooth": { "type": "boolean" },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 16 }
    },
    "preview": { "type": "string" },
    "frames": { "type": "string" }
  },
  "additionalProperties": true
}
